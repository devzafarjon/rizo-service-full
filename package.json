{
  "name": "rizo-service",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "postinstall": "npm run prisma:generate -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:seed": "npm run prisma:seed -w server",
    "db:reset": "npm run prisma:reset -w server",
    "smoke": "npm run smoke -w server"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "multer": "^2.4.0"
  }
}
