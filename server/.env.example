DATABASE_URL="postgresql://USER@localhost:5432/rizo_service?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# SMS / Telegram (console logs by default; set HTTP/bot credentials when ready)
SMS_PROVIDER="console"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
# SMS_PROVIDER="eskiz" sends through eskiz.uz (account e-mail + password; sender "4546" until your own name is approved)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_SENDER="4546"
TELEGRAM_PROVIDER="console"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Daily pg_dump at 02:00 Asia/Tashkent when enabled
BACKUP_ENABLED="false"
BACKUP_DIR=""
BACKUP_RETAIN_DAYS="30"

# Online payment pages for customers (links only; the office records the payment). Leave empty to hide the buttons.
PAYME_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""

# The RIZO market sends this in the X-Api-Key header when it posts a sale to /api/integrations/market/sales.
# Empty = the integration is off.
MARKET_API_KEY=""

# Push notifications (Firebase Cloud Messaging). Paste the service-account JSON here on the host, or give a file path when developing.
# Without either, pushes are only logged. Never commit the JSON file.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Photo / signature storage in an S3-compatible bucket (Cloudflare R2). Without it files live on the server disk only,
# which a free host wipes on every deploy. Endpoint looks like https://<account id>.r2.cloudflarestorage.com
UPLOAD_BUCKET_ENDPOINT=
UPLOAD_BUCKET_NAME=
UPLOAD_BUCKET_ACCESS_KEY_ID=
UPLOAD_BUCKET_SECRET_ACCESS_KEY=
