DATABASE_URL="postgresql://USER@localhost:5432/rizo_service?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# SMS / Telegram (console logs by default; set HTTP/bot credentials when ready)
SMS_PROVIDER="console"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
TELEGRAM_PROVIDER="console"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Daily pg_dump at 02:00 Asia/Tashkent when enabled
BACKUP_ENABLED="false"
BACKUP_DIR=""
BACKUP_RETAIN_DAYS="30"
