DATABASE_URL="postgresql://USER@localhost:5432/rizo_service?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# SMS / Telegram (console logs by default; set HTTP/bot credentials when ready)
SMS_PROVIDER="console"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
TELEGRAM_PROVIDER="console"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Daily pg_dump at 02:00 Asia/Tashkent when enabled
BACKUP_ENABLED="false"
BACKUP_DIR=""
BACKUP_RETAIN_DAYS="30"

# Online payment pages for customers (links only; the office records the payment). Leave empty to hide the buttons.
PAYME_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""

# The RIZO market sends this in the X-Api-Key header when it posts a sale to /api/integrations/market/sales.
# Empty = the integration is off.
MARKET_API_KEY=""

# Push notifications (Firebase Cloud Messaging). Paste the service-account JSON here on the host, or give a file path when developing.
# Without either, pushes are only logged. Never commit the JSON file.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
