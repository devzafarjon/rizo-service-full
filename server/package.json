{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "smoke": "node --import tsx/esm scripts/smoke.ts",
    "smoke:growth": "node --import tsx/esm scripts/growth-smoke.ts",
    "smoke:auto": "node --import tsx/esm scripts/auto-smoke.ts",
    "smoke:brands": "node --import tsx/esm scripts/brands-smoke.ts",
    "push-test": "node --import tsx/esm scripts/push-test.ts",
    "backup": "node --import tsx/esm scripts/backup.ts",
    "set-password": "node --import tsx/esm scripts/set-password.ts",
    "add-demo-accounts": "node --import tsx/esm scripts/add-demo-accounts.ts",
    "demo:load": "node --import tsx/esm scripts/demo-load.ts",
    "demo:clean": "node --import tsx/esm scripts/demo-clean.ts",
    "demo:catalog": "node --import tsx/esm scripts/demo-catalog.ts",
    "smoke:parts": "node --import tsx/esm scripts/parts-smoke.ts",
    "smoke:warehouses": "node --import tsx/esm scripts/warehouses-smoke.ts",
    "smoke:telegram": "node --import tsx/esm scripts/telegram-smoke.ts",
    "smoke:auth": "node --import tsx/esm scripts/auth-smoke.ts",
    "smoke:rbac": "node --import tsx/esm scripts/rbac-smoke.ts",
    "smoke:concurrency": "node --import tsx/esm scripts/concurrency-smoke.ts",
    "smoke:fuzz": "node --import tsx/esm scripts/fuzz-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
