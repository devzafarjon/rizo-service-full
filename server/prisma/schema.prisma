generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  admin
  technician
}

enum TechnicianType {
  service_center
  mobile
}

enum ServiceType {
  installation
  repair
}

enum RequestSource {
  rizo_market
  rizo_service
}

enum DefectType {
  dead_on_arrival
  failed_during_use
}

enum LocationType {
  in_shop
  on_site
}

enum RequestStatus {
  scheduled
  in_progress
  completed
  received
  diagnosing
  awaiting_parts
  repairing
  ready_for_pickup
  replaced
  closed
}

enum Priority {
  low
  medium
  high
  urgent
}

enum WarrantyStatus {
  in_warranty
  expired
  not_applicable
}

enum PaymentStatus {
  not_required
  pending
  paid
}

enum NoteAuthorScope {
  staff
  customer
}

model StaffUser {
  id              String           @id @default(cuid())
  name            String
  phone           String           @unique
  passwordHash    String           @map("password_hash")
  role            StaffRole
  technicianType  TechnicianType?  @map("technician_type")
  isAvailable     Boolean          @default(true) @map("is_available")
  locale          String           @default("uz") @db.VarChar(5)
  createdAt       DateTime         @default(now()) @map("created_at")
  assignedRequests ServiceRequest[] @relation("AssignedTechnician")
  notes           RequestNote[]
  photos          RequestPhoto[]   @relation("StaffPhotoUploader")

  @@map("staff_users")
}

model Customer {
  id           String           @id @default(cuid())
  name         String
  phone        String           @unique
  passwordHash String           @map("password_hash")
  address      String?
  regionCode   String           @default("00") @map("region_code") @db.VarChar(2)
  locale       String           @default("uz") @db.VarChar(5)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  sales        Sale[]
  requests     ServiceRequest[]
  feedback     Feedback[]
  notifications Notification[]
  requestNotes RequestNote[]
  photos       RequestPhoto[]   @relation("CustomerPhotoUploader")

  @@map("customers")
}

model Product {
  id         String           @id @default(cuid())
  name       String
  nameUz     String           @default("") @map("name_uz")
  nameRu     String           @default("") @map("name_ru")
  nameEn     String           @default("") @map("name_en")
  sku        String           @unique
  category   String
  createdAt  DateTime         @default(now()) @map("created_at")
  sales      Sale[]
  requests   ServiceRequest[]

  @@index([category])
  @@map("products")
}

model Sale {
  id             String           @id @default(cuid())
  customerId     String           @map("customer_id")
  productId      String           @map("product_id")
  quantity       Int
  saleDate       DateTime         @map("sale_date") @db.Date
  pricePaid      Decimal          @map("price_paid") @db.Decimal(12, 2)
  warrantyMonths Int              @map("warranty_months")
  warrantyExpiry DateTime         @map("warranty_expiry") @db.Date
  invoiceNumber  String           @unique @map("invoice_number")
  createdAt      DateTime         @default(now()) @map("created_at")
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  requests       ServiceRequest[]

  @@index([customerId])
  @@index([productId])
  @@map("sales")
}

model ServiceCatalogItem {
  id              String               @id @default(cuid())
  name            String
  nameUz          String               @default("") @map("name_uz")
  nameRu          String               @default("") @map("name_ru")
  nameEn          String               @default("") @map("name_en")
  price           Decimal              @db.Decimal(12, 2)
  productCategory String               @map("product_category")
  createdAt       DateTime             @default(now()) @map("created_at")
  requestLines    RequestServiceLine[]

  @@index([productCategory])
  @@map("service_catalog_items")
}

model SparePart {
  id              String            @id @default(cuid())
  name            String
  nameUz          String            @default("") @map("name_uz")
  nameRu          String            @default("") @map("name_ru")
  nameEn          String            @default("") @map("name_en")
  price           Decimal           @db.Decimal(12, 2)
  productCategory String            @map("product_category")
  stockQuantity   Int               @default(0) @map("stock_quantity")
  createdAt       DateTime          @default(now()) @map("created_at")
  requestLines    RequestPartLine[]

  @@index([productCategory])
  @@map("spare_parts")
}

model ServiceRequest {
  id                     String            @id @default(cuid())
  displayId              String            @unique @map("display_id")
  type                   ServiceType
  source                 RequestSource     @default(rizo_service)
  submittedByCustomer    Boolean           @default(false) @map("submitted_by_customer")
  saleId                 String?           @map("sale_id")
  customerId             String            @map("customer_id")
  productId              String            @map("product_id")
  issueDescription       String            @map("issue_description")
  defectType             DefectType?       @map("defect_type")
  locationType           LocationType      @map("location_type")
  customerLocation       Json?             @map("customer_location")
  technicianTypeRequired TechnicianType    @map("technician_type_required")
  assignedTechnicianId   String?           @map("assigned_technician_id")
  status                 RequestStatus
  priority               Priority          @default(medium)
  warrantyStatus         WarrantyStatus    @map("warranty_status")
  isPaidRepair           Boolean           @default(false) @map("is_paid_repair")
  estimatedCost          Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  finalCost              Decimal?          @map("final_cost") @db.Decimal(12, 2)
  paymentStatus          PaymentStatus     @default(not_required) @map("payment_status")
  customerApprovedAt     DateTime?         @map("customer_approved_at")
  receivedAt             DateTime?         @map("received_at")
  acceptedAt             DateTime?         @map("accepted_at")
  arrivedAt              DateTime?         @map("arrived_at")
  completedAt            DateTime?         @map("completed_at")
  createdAt              DateTime         @default(now()) @map("created_at")

  sale                 Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product              Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  assignedTechnician   StaffUser?           @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  pauses               RequestPause[]
  serviceLines         RequestServiceLine[]
  partLines            RequestPartLine[]
  extraExpenses        RequestExtraExpense[]
  photos               RequestPhoto[]
  notes                RequestNote[]
  feedback             Feedback?
  notifications        Notification[]

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([warrantyStatus])
  @@map("service_requests")
}

model DailyRequestCounter {
  date         DateTime @id @db.Date
  lastSequence Int      @map("last_sequence")

  @@map("daily_request_counters")
}

model RequestPause {
  id                String         @id @default(cuid())
  serviceRequestId  String         @map("service_request_id")
  pausedAt          DateTime       @default(now()) @map("paused_at")
  resumedAt         DateTime?      @map("resumed_at")
  reason            String
  customTimerHours  Decimal        @map("custom_timer_hours") @db.Decimal(8, 2)
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_pauses")
}

model RequestServiceLine {
  id                   String             @id @default(cuid())
  serviceRequestId     String             @map("service_request_id")
  serviceCatalogItemId String             @map("service_catalog_item_id")
  priceAtTime          Decimal            @map("price_at_time") @db.Decimal(12, 2)
  serviceRequest       ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceCatalogItem   ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_service_lines")
}

model RequestPartLine {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  sparePartId      String         @map("spare_part_id")
  quantity         Int
  priceAtTime      Decimal        @map("price_at_time") @db.Decimal(12, 2)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  sparePart        SparePart      @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_part_lines")
}

model RequestExtraExpense {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  description      String
  price            Decimal        @db.Decimal(12, 2)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_extra_expenses")
}

model RequestPhoto {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  photoUrl         String         @map("photo_url")
  uploadedBy       String         @map("uploaded_by")
  staffUserId      String?        @map("staff_user_id")
  customerId       String?        @map("customer_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  staffUser        StaffUser?     @relation("StaffPhotoUploader", fields: [staffUserId], references: [id], onDelete: SetNull)
  customer         Customer?      @relation("CustomerPhotoUploader", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId])
  @@map("request_photos")
}

model RequestNote {
  id                  String          @id @default(cuid())
  serviceRequestId    String          @map("service_request_id")
  userId              String          @map("user_id")
  authorScope         NoteAuthorScope @map("author_scope")
  staffUserId         String?         @map("staff_user_id")
  customerId          String?         @map("customer_id")
  noteText            String          @map("note_text")
  isVisibleToCustomer Boolean         @default(false) @map("is_visible_to_customer")
  createdAt           DateTime        @default(now()) @map("created_at")
  serviceRequest      ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  staffUser           StaffUser?      @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId])
  @@map("request_notes")
}

model Feedback {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique @map("service_request_id")
  customerId       String         @map("customer_id")
  rating           Int
  comment          String?
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("feedback")
}

model Notification {
  id               String         @id @default(cuid())
  customerId       String         @map("customer_id")
  serviceRequestId String         @map("service_request_id")
  message          String
  code             String?
  params           Json?
  isRead           Boolean        @default(false) @map("is_read")
  createdAt        DateTime       @default(now()) @map("created_at")
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([customerId, isRead])
  @@map("notifications")
}
