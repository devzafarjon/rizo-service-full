generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  admin
  technician
  receptionist
}

enum TechnicianType {
  service_center
  mobile
}

enum ServiceType {
  installation
  repair
}

enum RequestSource {
  rizo_market
  rizo_service
}

enum DefectType {
  dead_on_arrival
  failed_during_use
}

enum LocationType {
  in_shop
  on_site
}

// Repairs: new -> diagnosing -> awaiting_decision -> awaiting_parts -> in_progress -> ready -> picked_up,
// closed by replaced / refunded / rejected. Installations: new -> in_progress -> completed.
enum RequestStatus {
  new
  diagnosing
  awaiting_decision
  awaiting_parts
  in_progress
  paused
  ready
  completed
  picked_up
  rejected
  replaced
  refunded
  cancelled
}

enum ResolutionType {
  repair
  replace
  refund
}

enum RequestDecision {
  warranty_repair
  paid_repair
  replace
  refund
  reject
}

enum EstimateStatus {
  draft
  sent
  approved
  declined
  expired
}

enum EstimateLineKind {
  service
  part
  labor
  other
}

enum PaymentMethod {
  cash
  card
  transfer
  payme
  click
  other
}

enum PaymentKind {
  payment
  refund
}

enum PartOrderStatus {
  requested
  ordered
  received
  cancelled
}

enum DefectCodeKind {
  defect
  return_reason
}

enum SaleSource {
  rizo
  registered
}

enum PickupConfirmationType {
  tap
  signature
}

enum Priority {
  low
  medium
  high
  urgent
}

enum WarrantyStatus {
  in_warranty
  expired
  not_applicable
}

enum PaymentStatus {
  not_required
  pending
  partial
  paid
}

enum NoteAuthorScope {
  staff
  customer
}

model StaffUser {
  id              String           @id @default(cuid())
  name            String
  phone           String           @unique
  passwordHash    String           @map("password_hash")
  role            StaffRole
  technicianType  TechnicianType?  @map("technician_type")
  isAvailable     Boolean          @default(true) @map("is_available")
  isActive        Boolean          @default(true) @map("is_active")
  payPercent      Decimal          @default(0) @map("pay_percent") @db.Decimal(5, 2)
  payFixedPerJob  Decimal          @default(0) @map("pay_fixed_per_job") @db.Decimal(12, 2)
  serviceCenterId String?          @map("service_center_id")
  serviceCenter   ServiceCenter?   @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull)
  payAdjustments  PayAdjustment[]
  locale          String           @default("uz") @db.VarChar(5)
  createdAt       DateTime         @default(now()) @map("created_at")
  assignedRequests ServiceRequest[] @relation("AssignedTechnician")
  notes           RequestNote[]
  photos          RequestPhoto[]   @relation("StaffPhotoUploader")
  schedules       TechnicianSchedule[]
  alerts          Notification[]   @relation("StaffAlerts")

  @@map("staff_users")
}

model Customer {
  id           String           @id @default(cuid())
  name         String
  phone        String           @unique
  passwordHash String           @map("password_hash")
  address      String?
  regionCode   String           @default("00") @map("region_code") @db.VarChar(2)
  locale       String           @default("uz") @db.VarChar(5)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  sales        Sale[]
  requests     ServiceRequest[]
  feedback     Feedback[]
  notifications Notification[]
  requestNotes RequestNote[]
  photos       RequestPhoto[]   @relation("CustomerPhotoUploader")
  telegramChatId String?        @map("telegram_chat_id")

  @@map("customers")
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("product_categories")
}

model Product {
  id         String           @id @default(cuid())
  name       String
  nameUz     String           @default("") @map("name_uz")
  nameRu     String           @default("") @map("name_ru")
  nameEn     String           @default("") @map("name_en")
  sku        String           @unique
  category   String
  warrantyMonths     Int      @default(12) @map("warranty_months")
  warrantyStartsOn   String   @default("installation") @map("warranty_starts_on")
  warrantyCoversLabor Boolean @default(true) @map("warranty_covers_labor")
  warrantyCoversParts Boolean @default(true) @map("warranty_covers_parts")
  categoryRef ProductCategory @relation(fields: [category], references: [name], onUpdate: Cascade, onDelete: Restrict)
  createdAt  DateTime         @default(now()) @map("created_at")
  sales      Sale[]
  requests   ServiceRequest[]
  replacements ReplacementItem[]

  @@index([category])
  @@map("products")
}

model Sale {
  id             String           @id @default(cuid())
  customerId     String           @map("customer_id")
  productId      String           @map("product_id")
  quantity       Int
  saleDate       DateTime         @map("sale_date") @db.Date
  pricePaid      Decimal          @map("price_paid") @db.Decimal(12, 2)
  warrantyMonths Int              @map("warranty_months")
  warrantyExpiry DateTime         @map("warranty_expiry") @db.Date
  installationDate DateTime?      @map("installation_date") @db.Date
  serialNumber   String?           @map("serial_number")
  source         SaleSource        @default(rizo)
  isVerified     Boolean           @default(true) @map("is_verified")
  extensionMonths Int              @default(0) @map("extension_months")
  extensionReason String?          @map("extension_reason")
  voidedAt       DateTime?         @map("voided_at")
  voidReason     String?           @map("void_reason")
  invoiceNumber  String           @unique @map("invoice_number")
  createdAt      DateTime         @default(now()) @map("created_at")
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  requests       ServiceRequest[]

  @@index([customerId])
  @@index([productId])
  @@index([serialNumber])
  @@map("sales")
}

model ServiceCatalogItem {
  id              String               @id @default(cuid())
  name            String
  nameUz          String               @default("") @map("name_uz")
  nameRu          String               @default("") @map("name_ru")
  nameEn          String               @default("") @map("name_en")
  price           Decimal              @db.Decimal(12, 2)
  productCategories String[]           @map("product_categories")
  createdAt       DateTime             @default(now()) @map("created_at")
  requestLines    RequestServiceLine[]

  @@map("service_catalog_items")
}

model SparePart {
  id              String            @id @default(cuid())
  name            String
  nameUz          String            @default("") @map("name_uz")
  nameRu          String            @default("") @map("name_ru")
  nameEn          String            @default("") @map("name_en")
  price           Decimal           @db.Decimal(12, 2)
  costPrice       Decimal           @default(0) @map("cost_price") @db.Decimal(12, 2)
  productCategories String[]        @map("product_categories")
  stockQuantity      Int               @default(0) @map("stock_quantity")
  lowStockThreshold  Int               @default(3) @map("low_stock_threshold")
  lowStockNotifiedAt DateTime?         @map("low_stock_notified_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  requestLines       RequestPartLine[]
  alerts             Notification[]
  orders             PartOrder[]

  @@map("spare_parts")
}

model ServiceRequest {
  id                     String            @id @default(cuid())
  displayId              String            @unique @map("display_id")
  type                   ServiceType
  source                 RequestSource     @default(rizo_service)
  submittedByCustomer    Boolean           @default(false) @map("submitted_by_customer")
  saleId                 String?           @map("sale_id")
  customerId             String            @map("customer_id")
  productId              String            @map("product_id")
  issueDescription       String            @map("issue_description")
  defectType             DefectType?       @map("defect_type")
  resolutionType         ResolutionType?   @map("resolution_type")
  decision               RequestDecision?
  decisionNote           String?           @map("decision_note")
  decidedAt              DateTime?         @map("decided_at")
  rejectionReason        String?           @map("rejection_reason")
  serialNumber           String?           @map("serial_number")
  statusChangedAt        DateTime          @default(now()) @map("status_changed_at")
  scheduledAt            DateTime?         @map("scheduled_at")
  enRouteAt              DateTime?         @map("en_route_at")
  legalDueAt             DateTime?         @map("legal_due_at")
  trackingToken          String            @unique @default(cuid()) @map("tracking_token")
  intakeChecklist        Json?             @map("intake_checklist")
  intakeNotes            String?           @map("intake_notes")
  intakeSignatureUrl     String?           @map("intake_signature_url")
  fiscalReceiptNumber    String?           @map("fiscal_receipt_number")
  repairWarrantyUntil    DateTime?         @map("repair_warranty_until") @db.Date
  isRepeat               Boolean           @default(false) @map("is_repeat")
  repeatOfId             String?           @map("repeat_of_id")
  workedMinutes          Int?              @map("worked_minutes")
  defectCodeId           String?           @map("defect_code_id")
  returnReasonId         String?           @map("return_reason_id")
  serviceCenterId        String?           @map("service_center_id")
  defectCode             DefectCode?       @relation("RequestDefectCode", fields: [defectCodeId], references: [id], onDelete: SetNull)
  returnReason           DefectCode?       @relation("RequestReturnReason", fields: [returnReasonId], references: [id], onDelete: SetNull)
  serviceCenter          ServiceCenter?    @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull)
  estimates              Estimate[]
  payments               Payment[]
  partOrders             PartOrder[]
  locationType           LocationType      @map("location_type")
  customerLocation       Json?             @map("customer_location")
  technicianTypeRequired TechnicianType    @map("technician_type_required")
  assignedTechnicianId   String?           @map("assigned_technician_id")
  status                 RequestStatus
  priority               Priority          @default(medium)
  warrantyStatus         WarrantyStatus    @map("warranty_status")
  isPaidRepair           Boolean           @default(false) @map("is_paid_repair")
  estimatedCost          Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  finalCost              Decimal?          @map("final_cost") @db.Decimal(12, 2)
  paymentStatus          PaymentStatus     @default(not_required) @map("payment_status")
  customerApprovedAt     DateTime?         @map("customer_approved_at")
  receivedAt             DateTime?         @map("received_at")
  assignedAt             DateTime?         @map("assigned_at")
  acceptedAt             DateTime?         @map("accepted_at")
  arrivedAt              DateTime?         @map("arrived_at")
  completedAt            DateTime?         @map("completed_at")
  overdueAt              DateTime?         @map("overdue_at")
  overdueNotifiedAt      DateTime?         @map("overdue_notified_at")
  pickupConfirmedAt      DateTime?         @map("picked_up_at")
  pickupConfirmationType PickupConfirmationType? @map("pickup_confirmation_type")
  pickupSignatureUrl     String?           @map("pickup_signature_url")
  pickupConfirmedBy      String?           @map("pickup_confirmed_by")
  createdAt              DateTime          @default(now()) @map("created_at")

  sale                 Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product              Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  assignedTechnician   StaffUser?           @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  pauses               RequestPause[]
  serviceLines         RequestServiceLine[]
  partLines            RequestPartLine[]
  extraExpenses        RequestExtraExpense[]
  photos               RequestPhoto[]
  notes                RequestNote[]
  feedback             Feedback?
  notifications        Notification[]
  replacement          ReplacementItem?

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([warrantyStatus])
  @@index([serialNumber])
  @@index([scheduledAt])
  @@map("service_requests")
}

model ReplacementItem {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique @map("service_request_id")
  productId        String         @map("product_id")
  serialNumber     String         @map("serial_number")
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("replacement_items")
}

model ServiceCenter {
  id           String           @id @default(cuid())
  name         String
  regionCode   String           @default("00") @map("region_code") @db.VarChar(2)
  address      String
  phone        String?
  workingHours String?          @map("working_hours")
  lat          Float?
  lng          Float?
  isAuthorized Boolean          @default(true) @map("is_authorized")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  staff        StaffUser[]
  requests     ServiceRequest[]

  @@map("service_centers")
}

model Estimate {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  status           EstimateStatus @default(draft)
  note             String?
  validUntil       DateTime       @map("valid_until")
  sentAt           DateTime?      @map("sent_at")
  approvedAt       DateTime?      @map("approved_at")
  approvedBy       String?        @map("approved_by")
  declinedAt       DateTime?      @map("declined_at")
  declineReason    String?        @map("decline_reason")
  createdById      String?        @map("created_by_id")
  createdByName    String?        @map("created_by_name")
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  lines            EstimateLine[]

  @@index([serviceRequestId])
  @@map("estimates")
}

model EstimateLine {
  id                   String           @id @default(cuid())
  estimateId           String           @map("estimate_id")
  kind                 EstimateLineKind
  serviceCatalogItemId String?          @map("service_catalog_item_id")
  sparePartId          String?          @map("spare_part_id")
  name                 String
  quantity             Int              @default(1)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(12, 2)
  isOptional           Boolean          @default(false) @map("is_optional")
  isSelected           Boolean          @default(true) @map("is_selected")
  isFulfilled          Boolean          @default(false) @map("is_fulfilled")
  estimate             Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_lines")
}

model Payment {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  kind             PaymentKind    @default(payment)
  method           PaymentMethod  @default(cash)
  amount           Decimal        @db.Decimal(12, 2)
  note             String?
  createdById      String?        @map("created_by_id")
  createdByName    String?        @map("created_by_name")
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("payments")
}

model PartOrder {
  id               String          @id @default(cuid())
  sparePartId      String          @map("spare_part_id")
  quantity         Int
  status           PartOrderStatus @default(requested)
  supplier         String?
  note             String?
  serviceRequestId String?         @map("service_request_id")
  expectedAt       DateTime?       @map("expected_at") @db.Date
  receivedAt       DateTime?       @map("received_at")
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  sparePart        SparePart       @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("part_orders")
}

model DefectCode {
  id              String         @id @default(cuid())
  kind            DefectCodeKind @default(defect)
  code            String
  name            String
  nameUz          String         @default("") @map("name_uz")
  nameRu          String         @default("") @map("name_ru")
  nameEn          String         @default("") @map("name_en")
  productCategory String?        @map("product_category")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  defectRequests  ServiceRequest[] @relation("RequestDefectCode")
  returnRequests  ServiceRequest[] @relation("RequestReturnReason")

  @@unique([kind, code])
  @@map("defect_codes")
}

model PayAdjustment {
  id            String    @id @default(cuid())
  staffUserId   String    @map("staff_user_id")
  amount        Decimal   @db.Decimal(12, 2)
  reason        String
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("pay_adjustments")
}

model DailyRequestCounter {
  date         DateTime @id @db.Date
  lastSequence Int      @map("last_sequence")

  @@map("daily_request_counters")
}

model RequestPause {
  id                String         @id @default(cuid())
  serviceRequestId  String         @map("service_request_id")
  pausedAt          DateTime       @default(now()) @map("paused_at")
  resumedAt         DateTime?      @map("resumed_at")
  reason            String
  customTimerHours  Decimal        @map("custom_timer_hours") @db.Decimal(8, 2)
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_pauses")
}

model RequestServiceLine {
  id                   String             @id @default(cuid())
  serviceRequestId     String             @map("service_request_id")
  serviceCatalogItemId String             @map("service_catalog_item_id")
  priceAtTime          Decimal            @map("price_at_time") @db.Decimal(12, 2)
  serviceRequest       ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  serviceCatalogItem   ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_service_lines")
}

model RequestPartLine {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  sparePartId      String         @map("spare_part_id")
  quantity         Int
  priceAtTime      Decimal        @map("price_at_time") @db.Decimal(12, 2)
  costAtTime       Decimal        @default(0) @map("cost_at_time") @db.Decimal(12, 2)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  sparePart        SparePart      @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_part_lines")
}

model RequestExtraExpense {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  description      String
  price            Decimal        @db.Decimal(12, 2)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_extra_expenses")
}

model RequestPhoto {
  id               String         @id @default(cuid())
  serviceRequestId String         @map("service_request_id")
  photoUrl         String         @map("photo_url")
  uploadedBy       String         @map("uploaded_by")
  staffUserId      String?        @map("staff_user_id")
  customerId       String?        @map("customer_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  staffUser        StaffUser?     @relation("StaffPhotoUploader", fields: [staffUserId], references: [id], onDelete: SetNull)
  customer         Customer?      @relation("CustomerPhotoUploader", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId])
  @@map("request_photos")
}

model RequestNote {
  id                  String          @id @default(cuid())
  serviceRequestId    String          @map("service_request_id")
  userId              String          @map("user_id")
  authorScope         NoteAuthorScope @map("author_scope")
  staffUserId         String?         @map("staff_user_id")
  customerId          String?         @map("customer_id")
  noteText            String          @map("note_text")
  isVisibleToCustomer Boolean         @default(false) @map("is_visible_to_customer")
  createdAt           DateTime        @default(now()) @map("created_at")
  serviceRequest      ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  staffUser           StaffUser?      @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId])
  @@map("request_notes")
}

model Feedback {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique @map("service_request_id")
  customerId       String         @map("customer_id")
  rating           Int
  comment          String?
  tags             String[]       @default([])
  createdAt        DateTime       @default(now()) @map("created_at")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("feedback")
}

model Notification {
  id               String          @id @default(cuid())
  audience         String          @default("customer")
  customerId       String?         @map("customer_id")
  staffUserId      String?         @map("staff_user_id")
  serviceRequestId String?         @map("service_request_id")
  sparePartId      String?         @map("spare_part_id")
  message          String
  code             String?
  params           Json?
  isRead           Boolean         @default(false) @map("is_read")
  createdAt        DateTime        @default(now()) @map("created_at")
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staffUser        StaffUser?      @relation("StaffAlerts", fields: [staffUserId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  sparePart        SparePart?      @relation(fields: [sparePartId], references: [id], onDelete: SetNull)

  @@index([customerId, isRead])
  @@index([staffUserId, isRead])
  @@map("notifications")
}

model TechnicianSchedule {
  id           String    @id @default(cuid())
  technicianId String    @map("technician_id")
  date         DateTime  @db.Date
  isWorking    Boolean   @default(true) @map("is_working")
  startTime    String?   @map("start_time") @db.VarChar(5)
  endTime      String?   @map("end_time") @db.VarChar(5)
  technician   StaffUser @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, date])
  @@index([date])
  @@map("technician_schedules")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  userType   String   @map("user_type")
  userName   String?  @map("user_name")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboundMessage {
  id        String    @id @default(cuid())
  channel   String
  to        String
  body      String
  status    String    @default("pending")
  error     String?
  code      String?
  entityId  String?   @map("entity_id")
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status])
  @@index([createdAt])
  @@map("outbound_messages")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}
